NEXT_PUBLIC_API_URL=http://localhost:8000
OPSMIND_EMBEDDING_PROVIDER=semantic
OPSMIND_MODEL_CACHE=data/model-cache
# Set true only in non-production environments.
OPSMIND_ENABLE_EVALUATION=false
# Optional: enables schema-constrained LLM hypothesis generation.
OPENAI_API_KEY=
OPSMIND_LLM_ENABLED=false
OPSMIND_LLM_MODEL=gpt-5.6-terra
OPSMIND_LLM_TIMEOUT_SECONDS=20
